# Copy to .env only if you need to override something. Both are optional:
# with no .env at all the app talks to the live API below.

# Base URL for every request. The app appends:
#   /all_leagues.php                          the league list
#   /lookupleague.php?id=<id>                 alternate names, on selection
#   /search_all_seasons.php?badge=1&id=<id>   the season badge, on selection
VITE_SPORTS_DB_API_BASE_URL=https://www.thesportsdb.com/api/v1/json/3

# "true" serves the bundled multi-sport dataset through MSW instead of calling
# the live API. `npm run dev:mock` sets this for you.
# The live free tier returns five Soccer leagues without alternate names, so
# use the mock to see sport filtering and every badge state.
VITE_ENABLE_MOCK_API=false
